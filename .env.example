# Copy to .env and edit. Never commit .env.

# ---- Mode -------------------------------------------------------------------
# paper | live. The paper entrypoint forces paper regardless of this value.
CTBOT_MODE=paper

# Master live switch. Must be exactly "true" AND CTBOT_MODE=live AND the
# confirmation phrase below must match before the live adapter will construct.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRM=

# ---- Robinhood account (the ONLY account the bot may trade) ----------------
# Full account number AND nickname of the one account the bot may trade (set the nickname in the
# Robinhood app). Live verifies both, because other accounts (e.g. an IRA) can share the last 4 digits.
# Use a dedicated individual account. Never point it at retirement (IRA) or managed accounts.
ROBINHOOD_ACCOUNT_NUMBER=
ROBINHOOD_ACCOUNT_NICKNAME=

# ---- Claude decision engine -------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
MAX_CLAUDE_REVIEWS_PER_DAY=40  # cost cap: buy candidates beyond this are logged, not reviewed
MAX_REVIEWS_PER_MODEL_PER_DAY=15  # per-model share of that budget
MAX_ASSISTANT_MESSAGES_PER_DAY=100  # dashboard assistant (Bub) chats; separate from the review budget
MAX_CLAUDE_USD_PER_DAY=1.00    # measured review spend (data/llm_usage.jsonl); no more reviews today after it
REVIEW_SHADOW_IDEAS=false      # true: also pay to review ideas from shadow models (they never trade)
REVIEW_OUTCOME_MEMORY=true     # show the reviewer each model's settled paper results (no extra call)
REVIEW_DEBATE=false            # true: two short extra calls (case for / against) before each verdict
# Cheaper reviews: CLAUDE_MODEL=claude-haiku-5-5 costs ~1/40 of Opus per review; compare with
# ctbot-score-ideas before switching for good.
# Knobs the assistant changes (with your Apply click) are saved in ~/.ctbot/tuning.json and override
# the values below; Settings -> Assistant changes reverts them.

# ---- Account / risk (defaults sized for a small cash account) ------------------------
STARTING_CAPITAL=250
SIZE_BY=claude                 # claude: Claude's suggested size, capped | risk: always MAX_POSITION_PCT
MAX_TRADING_CAPITAL=250         # hard cap on dollars deployed; new deposits are not used
MAX_POSITION_PCT=0.20          # max 20% of equity in one position (~$50)
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=0.03        # halt for the day after -3%
MAX_TOTAL_DRAWDOWN_PCT=0.15    # kill switch after -15% from peak
MIN_SHARE_PRICE=5
MIN_AVG_DOLLAR_VOLUME=20000000
ALLOW_SHORT=false              # long-only by policy (no shorting)
PDT_RULE=false                 # old 3-per-5-days PDT cap; FINRA/Robinhood dropped it 2026-06-04
MAX_DAY_TRADES_5D=3            # cap used only when PDT_RULE=true
MAX_QUOTE_AGE_S=120            # entries refuse a quote older than this
# Kill switch file: `touch data/HALT` blocks every new entry (exits still run); delete it to resume.
MIN_CLAUDE_CONFIDENCE=0.65
MAX_SPREAD_PCT=0.01            # reject entries when (ask-bid)/mid is wider than 1%
ENTRY_LIMIT_SLACK_PCT=0.002    # buy limit = ask x 1.002: room for the price to move during a Claude review
DEFAULT_STOP_LOSS_PCT=0.05     # stop when Claude suggests none
MAX_STOP_LOSS_PCT=0.10         # cap on Claude's suggested stop
NO_ENTRIES_LAST_MINUTES=15     # no new entries this close to the 16:00 ET close
SWING_MIN_PROFIT_PCT=0.01      # a model trade up 1%+ near its exit is held to the next close
MODEL_MAX_LOSING_STREAK=3      # pause a model for the rest of the day after 3 straight losses (0 = never)
SWING_MAX_DAYS=2               # at most this many extra sessions; 0 disables swinging
RESPECT_MARKET_HOURS=true      # skip cycles outside 9:30-16:00 ET Mon-Fri (no holiday calendar)
# Day-trader pack checks (trader-exit / -budget / -risk). 0 or empty = off; only the first is on.
MIN_STOP_DISTANCE_PCT=0.0005   # refuse a model's stop closer than 0.05% to its entry (spread noise)
MIN_REWARD_RISK=0              # e.g. 1.0: a model's target must be at least 1x its risk away
MAX_LOSS_PER_TRADE_PCT=0       # e.g. 0.01: size reviewed buys so the loss at the stop is <= 1% of capital
MAX_OPEN_RISK_PCT=0            # e.g. 0.03: loss at every open stop plus the new one <= 3% of equity
MAX_ENTRIES_PER_DAY=0          # e.g. 6: new positions per trading day
NO_ENTRIES_BEFORE=             # e.g. 09:45: no new entries in the first 15 minutes (ET)
# Trading-skill rules (off; the skill_rules book in config/variants.toml tries all three)
PARTIAL_PROFIT_R=0             # e.g. 1.0: sell half once up 1R, stop to break-even, the rest trails
VWAP_ENTRY_GATE=false          # true: same-day plans buy only above today's session VWAP
REGIME_GATE=false              # true: no Claude-reviewed entries while SPY's regime is "bear"

# ---- Alternative data providers --------------------------------------------
# Comma-separated: json_file, quiver, unusual_whales, robinhood_mcp, collective2, cboe_options,
# tradingflow_options, house_clerk
# house_clerk: free House members' stock trades from the Clerk's public PTRs, for the congressional
# strategy (no key). Reading the PDFs needs pdftotext: `brew install poppler`. Cache: HOUSE_PTR_DIR.
ALT_DATA_PROVIDERS=json_file
EVENTS_DIR=data/events
QUIVER_API_KEY=
UNUSUAL_WHALES_API_KEY=
C2_API_KEY=                    # Collective2 read-only research API
# cboe_options: free 15-min-delayed option chains from Cboe, downloaded once a day after
# 14:30 ET (~100 MB for the universe's stocks) and filtered to unusual volume for options_flow.
CBOE_OPTIONS_EXCLUDE=SPY,QQQ,IWM,DIA,XLF,XLE,XLK,XLV,XLY,XLP,XLI,XLU,XLB,XLC,SMH,GLD,TLT
OPTIONS_FLOW_DIR=data/options_flow
# tradingflow_options: trade-level options flow from TradingFlow's MCP server (needs the key
# below). Direction comes from where each print traded (ask = bought, bid = sold), so it is
# stronger evidence than cboe_options. Use one of the two, not both.
TRADINGFLOW_FLOW_DIR=data/options_flow_tradingflow

# ---- Public market context (MARKET_DATA=robinhood only) ---------------------------
# TradingView's public scanner: next earnings dates for names outside Robinhood's large-cap
# calendar (the earnings guard uses the earlier date) plus technical context for reviews.
# Sends ticker symbols only; no account. false turns it off.
TRADINGVIEW_DATA=true
# Optional per-ticker news sentiment for reviews (free key, 100 requests/day: marketaux.com).
MARKETAUX_API_TOKEN=
# Optional SEC EDGAR context (free, no key): recent 8-K item codes and the last reported quarter for
# reviews, and new entries are refused after a bankruptcy, delisting-notice or non-reliance 8-K.
# SEC asks you to identify yourself: "Your Name you@example.com". Empty = off.
SEC_USER_AGENT=
# Time-machine odds (ctbot-timemachine) for intraday plans in reviews: no LLM cost, one extra read
# of ~60 days of 5-minute bars per reviewed intraday idea. false turns it off.
REVIEW_REPLAY_ODDS=true
# Optional TradingFlow API key (app.tradingflow.com). With it set, TradingFlow backs up
# Robinhood's completed daily bars when Robinhood fails, and tradingflow_options can run.
# Quotes and intraday bars stay Robinhood-only. Market data only: it cannot see or trade your
# brokerage account.
TRADINGFLOW_API_KEY=
# Optional Webull OpenAPI keys (Webull website: OpenAPI Management > App Management). With both
# set, Webull candles back up Robinhood's completed daily bars (before TradingFlow; Webull's are
# split-adjusted) and feed the dashboard's stock chart. Read-only: only market-data paths are
# allowlisted, never orders. US stock data needs Webull's OpenAPI market-data subscription.
# If the Webull app has 2FA on, press Connect Webull on the Settings tab once and approve it in
# the Webull app; the token is kept in ~/.ctbot/webull_token.json.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# WEBULL_API_HOST=api.sandbox.webull.com   # Webull's test environment (default api.webull.com)

# ---- Ensemble ------------------------------------------------------------------
# Strategy on/off, weights and params live in config/strategies.toml.
STRATEGIES_FILE=config/strategies.toml
MIN_LONG_SCORE=0.15
MIN_EXIT_SCORE=0.10
MIN_AGREEING_STRATEGIES=2
MAX_CANDIDATES_PER_CYCLE=5     # caps Claude API calls per cycle

# ---- Paths -------------------------------------------------------------------
UNIVERSE_FILE=config/universe.txt
PAPER_SETTLEMENT=t1            # t1: proceeds settle next business day | instant: margin-style
PAPER_MARGIN=1                 # 1: cash only | up to 2: buy up to 2x equity ($2k min equity, 25% maintenance;
                               # raise MAX_TRADING_CAPITAL to match, no interest charged). Paper only.
ENTRY_MODE=manual              # manual: buys wait for your click on the dashboard | auto
MARKET_DATA=csv                # csv | robinhood (read-only; run ctbot-robinhood-login once)
BARS_DIR=data/bars             # <SYMBOL>.csv daily bars: date,open,high,low,close,volume
PAPER_LEDGER_PATH=data/paper_ledger.json
PAPER_RISK_STATE_PATH=data/paper_risk_state.json   # peak equity, kill switch, day trades
LOG_DIR=logs

# ---- Server heartbeat (optional; docs/CLOUD_HOSTING.md) ---------------------------
# A Healthchecks.io-style ping URL. ctbot-watchdog (every minute on a server) pings it while the bot
# is healthy and pings <url>/fail with a one-line reason when it isn't; no pings = server down.
HEARTBEAT_URL=
